# Salin menjadi .env lalu sesuaikan (dipakai docker compose)
FRONTEND_PORT=3000
BACKEND_PORT=8800
# Kosongkan agar browser memakai origin frontend (Next mem-proxy /api & /uploads ke backend).
# Isi mis. http://IP-SERVER:8800 bila ingin browser memanggil backend langsung.
NEXT_PUBLIC_API_BASE=
# Alamat publik aplikasi bila diakses lewat domain (Cloudflare Tunnel / reverse proxy), tanpa garis miring di akhir.
# Dipakai untuk menampilkan URL MCP di Settings > Instance-level MCP. Kosongkan bila hanya lokal.
PUBLIC_URL=
# Token Cloudflare Tunnel (Zero Trust > Networks > Tunnels > Install connector). Hanya untuk `--profile tunnel`.
TUNNEL_TOKEN=
